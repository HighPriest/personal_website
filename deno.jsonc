{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update": "deno run -A jsr:@check/deps",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postbuild": "deno run -A npm:svelte-sitemap --domain https://amun.pl --out-dir build/static"
  },
  "imports": {
    "@inlang/paraglide-sveltekit": "npm:@inlang/paraglide-sveltekit@0.15.0",
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@3.3.0",
    "@sveltejs/kit": "npm:@sveltejs/kit@2.7.2",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@4.0.0",
    "@ts-ghost/content-api": "npm:@ts-ghost/content-api@4.1.0",
    "@types/eslint": "npm:@types/eslint@9.6.1",
    "eslint": "npm:eslint@9.13.0",
    "eslint-config-prettier": "npm:eslint-config-prettier@9.1.0",
    "eslint-plugin-svelte": "npm:eslint-plugin-svelte@2.46.0",
    "globals": "npm:globals@15.11.0",
    "prettier": "npm:prettier@3.3.3",
    "prettier-plugin-svelte": "npm:prettier-plugin-svelte@3.2.7",
    "sass-embedded": "npm:sass-embedded@1.80.4",
    "svelte": "npm:svelte@5.1.1",
    "svelte-check": "npm:svelte-check@4.0.5",
    "svelte-sitemap": "npm:svelte-sitemap@2.6.0",
    "sveltekit-adapter-deno": "npm:sveltekit-adapter-deno@0.16.0",
    "typescript": "npm:typescript@5.6.3",
    "typescript-eslint": "npm:typescript-eslint@8.11.0",
    "vite": "npm:vite@5.4.10"
  }
}
