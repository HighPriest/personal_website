{
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update": "deno run -A jsr:@check/deps",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postbuild": "deno run -A npm:svelte-sitemap --domain https://amun.pl --out-dir build/static"
  },
  "devDependencies": {
    "@melt-ui/pp": "^0.3.2",
    "@melt-ui/svelte": "^0.86.2",
    "@sveltejs/adapter-auto": "^3.3.0",
    "@sveltejs/kit": "^2.7.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@ts-ghost/content-api": "^4.1.0",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "sass-embedded": "^1.80.4",
    "svelte": "^5.1.1",
    "svelte-check": "^4.0.5",
    "svelte-sitemap": "^2.6.0",
    "sveltekit-adapter-deno": "^0.16.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-inspector": "^0.1.4"
  },
  "dependencies": {
    "@inlang/paraglide-sveltekit": "^0.15.0"
  }
}
