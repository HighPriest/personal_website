{
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update": "deno run -A jsr:@check/deps",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postbuild": "pnpm dlx svelte-sitemap --domain https://amun.pl --out-dir build/prerendered",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@inlang/cli": "^3.1.9",
    "@inlang/paraglide-js": "^2.15.3",
    "@lukulent/svelte-umami": "^0.0.4",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@ts-ghost/content-api": "^5.0.0",
    "@types/eslint": "^9.6.1",
    "@types/ini": "^4.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "ini": "^6.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "sass-embedded": "^1.99.0",
    "svelte": "^5.55.2",
    "svelte-breadcrumbs": "^2.0.1",
    "svelte-check": "^4.4.6",
    "svelte-file-dropzone": "^2.0.9",
    "svelte-inspect-value": "^0.11.0",
    "svelte-sitemap": "^3.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vite-inspector": "^0.1.4",
    "vite-plugin-devtools-json": "^1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "svelte-kit"
    ]
  }
}
