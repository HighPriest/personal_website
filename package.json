{
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update": "deno run -A jsr:@check/deps",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postbuild": "pnpm dlx svelte-sitemap --domain https://amun.pl --out-dir build/prerendered",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@inlang/cli": "^3.0.7",
    "@inlang/paraglide-js": "2.0.5",
    "@lukulent/svelte-umami": "^0.0.4",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@ts-ghost/content-api": "^4.1.0",
    "@types/eslint": "^9.6.1",
    "@types/ini": "^4.1.1",
    "bits-ui": "^1.3.13",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^3.3.3",
    "globals": "^16.0.0",
    "ini": "^5.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "sass-embedded": "^1.86.0",
    "svelte": "^5.25.3",
    "svelte-breadcrumbs": "^2.0.1",
    "svelte-check": "^4.1.5",
    "svelte-file-dropzone": "^2.0.9",
    "svelte-inspect-value": "^0.5.0",
    "svelte-sitemap": "^2.7.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vite-inspector": "^0.1.4",
    "wx-svelte-core": "^2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
