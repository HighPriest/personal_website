{
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "update": "deno run -A jsr:@check/deps",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postbuild": "pnpm dlx svelte-sitemap --domain https://amun.pl --out-dir build/prerendered"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@ts-ghost/content-api": "^4.1.0",
    "@types/eslint": "^9.6.1",
    "@types/ini": "^4.1.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "ini": "^5.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "sass-embedded": "^1.83.4",
    "svelte": "^5.19.9",
    "svelte-check": "^4.1.4",
    "svelte-file-dropzone": "^2.0.9",
    "svelte-sitemap": "^2.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-inspector": "^0.1.4",
    "wx-svelte-core": "^2.0.1"
  },
  "dependencies": {
    "@inlang/paraglide-sveltekit": "^0.15.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
