{
	"name": "amun.pl",
	"private": true,
	"version": "0.4.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "node scripts/paraglide-compile.js",
		"check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.0",
		"@picocss/pico": "2.1.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/hast": "^3.0.5",
		"@types/ini": "4.1.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"hast-util-from-html": "^2.1.0",
		"hast-util-to-html": "^9.0.6",
		"ini": "^7.0.0",
		"jszip": "^3.10.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass-embedded": "^1.107.1",
		"shiki": "^4.6.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.6",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@11.15.1",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
